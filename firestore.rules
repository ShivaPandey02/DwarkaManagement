rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Contact form writes go through Cloud Functions (Admin SDK).
    // Deny all direct client access.
    match /contactSubmissions/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
